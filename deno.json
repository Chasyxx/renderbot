{
    "imports": {
        "@std/cli": "jsr:@std/cli@^1.0.22",
        "discord.js": "npm:discord.js@^14.13.0",
        "fluent-ffmpeg": "npm:fluent-ffmpeg@^2.1.3",
        "pako": "npm:pako@^2.0.4",
    
        "@types/fluent-ffmpeg": "npm:@types/fluent-ffmpeg@^2.1.3",
        "@types/pako": "npm:@types/pako@^2.0.4"
    },
    "compilerOptions": {
        "strict": true,
        "noImplicitAny": true,
        "strictNullChecks": true,
        "noImplicitReturns": true,
        "isolatedDeclarations": true,
        "noErrorTruncation": true,
        "noFallthroughCasesInSwitch": true,
        "noImplicitOverride": true,
        "noImplicitThis": true
    },
    "lint": {
        "rules": {
            "include": [
                "eqeqeq",
                "explicit-function-return-type",
                "guard-for-in",
                "no-non-null-asserted-optional-chain",
                "no-self-compare",
                "no-throw-literal",
                "no-unsafe-negation",
                "no-useless-rename"
            ],
            "tags": ["recommended"]
        }
    }
}